// STEWARD — Food Ordering Platform
// Paste this into https://dbdiagram.io/d to draw the ER diagram.
// Colours: blue = User Service, green = Restaurant Service,
//          orange = Order Service, purple = MongoDB.

Project STEWARD {
  database_type: 'PostgreSQL'
  Note: 'PostgreSQL database steward_db (9 tables) + MongoDB collection reviews'
}

// ---------- Allowed values (stored as VARCHAR + CHECK constraint) ----------

Enum user_role {
  USER
  ADMIN
}

Enum food_type {
  VEG
  NON_VEG
}

Enum order_status {
  PLACED
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  FAILED
}

Enum payment_status {
  PENDING
  SUCCESS
  FAILED
}

Enum reservation_status {
  RESERVED
  COMMITTED
  RELEASED
}

// ---------------------------- User Service ----------------------------

Table users [headercolor: #6c8ebf, note: 'Customers (mobile OTP / Google) and admins (email + password)'] {
  id bigint [pk, increment]
  full_name varchar(120)
  email varchar(255) [unique]
  phone varchar(16) [unique, note: 'Mobile number, e.g. +919876543210']
  google_sub varchar(64) [unique, note: 'Google account id']
  password_hash varchar(255) [note: 'bcrypt hash, admins only']
  role user_role [not null, default: 'USER']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

// ------------------------- Restaurant Service -------------------------

Table restaurants [headercolor: #82b366] {
  id bigint [pk, increment]
  name varchar(120) [not null]
  slug varchar(140) [not null, unique, note: 'URL name, e.g. wok-and-roll']
  cuisine varchar(120) [not null]
  address text [not null]
  city varchar(80) [not null]
  avg_delivery_minutes smallint [not null, default: 30]
  delivery_fee numeric(8,2) [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
}

Table categories [headercolor: #82b366, note: 'Starters, Mains, Desserts, ...'] {
  id int [pk, increment]
  name varchar(50) [not null, unique]
}

Table dishes [headercolor: #82b366, note: 'Menu items with live stock and a pgvector embedding for smart search'] {
  id bigint [pk, increment]
  restaurant_id bigint [not null, ref: > restaurants.id]
  category_id int [not null, ref: > categories.id]
  name varchar(120) [not null]
  description text
  food_type food_type [not null]
  spice_level smallint [not null, default: 0, note: '0 = mild ... 3 = very spicy']
  price numeric(8,2) [not null, note: 'CHECK price > 0']
  stock int [not null, default: 0, note: 'CHECK stock >= 0']
  is_available boolean [not null, default: true]
  embedding vector(384) [note: 'pgvector: meaning of the dish for natural-language search']

  indexes {
    (restaurant_id, name) [unique, name: 'one dish name per restaurant']
  }
}

Table inventory_reservations [headercolor: #82b366, note: 'Stock held for an order while it is being paid (Saga)'] {
  id bigint [pk, increment]
  order_id bigint [not null, note: 'The order this stock is held for (no FK: orders belong to the Order Service)']
  dish_id bigint [not null, ref: > dishes.id]
  quantity int [not null]
  status reservation_status [not null, default: 'RESERVED']

  indexes {
    (order_id, dish_id) [unique]
  }
}

// ---------------------------- Order Service ----------------------------

Table orders [headercolor: #d79b00] {
  id bigint [pk, increment]
  user_id bigint [not null, ref: > users.id]
  restaurant_id bigint [not null, ref: > restaurants.id]
  status order_status [not null, default: 'PLACED']
  subtotal numeric(10,2) [not null]
  delivery_fee numeric(10,2) [not null]
  tax_amount numeric(10,2) [not null]
  total_amount numeric(10,2) [not null, note: 'CHECK total = subtotal + delivery_fee + tax']
  delivery_address text [not null]
  created_at timestamptz [not null, default: `now()`]
}

Table order_items [headercolor: #d79b00, note: 'Junction table: links ORDERS and DISHES (many-to-many)'] {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  dish_id bigint [ref: > dishes.id, note: 'NULL if the dish is later deleted']
  dish_name varchar(120) [not null, note: 'Copied at order time']
  unit_price numeric(8,2) [not null, note: 'Copied at order time']
  quantity smallint [not null, note: 'CHECK 1-50']

  indexes {
    (order_id, dish_id) [unique]
  }
}

Table payments [headercolor: #d79b00, note: 'Razorpay Test Mode payments'] {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  user_id bigint [not null, ref: > users.id]
  provider varchar(10) [not null, note: 'RAZORPAY or MOCK (demo data)']
  razorpay_order_id varchar(64) [not null, unique]
  razorpay_payment_id varchar(64) [unique]
  amount numeric(10,2) [not null]
  method varchar(30) [note: 'upi, card, netbanking, wallet']
  status payment_status [not null, default: 'PENDING']
  created_at timestamptz [not null, default: `now()`]
}

Table order_status_history [headercolor: #d79b00, note: 'Every status change, used for order tracking'] {
  id bigint [pk, increment]
  order_id bigint [not null, ref: > orders.id]
  status order_status [not null]
  note text
  created_at timestamptz [not null, default: `now()`]
}

// ------------------------------- MongoDB -------------------------------

Table reviews [headercolor: #9673a6, note: 'MongoDB collection (document), not a PostgreSQL table'] {
  _id objectid [pk]
  user_id bigint [ref: > users.id, note: 'Who wrote it']
  restaurant_id bigint [ref: > restaurants.id, note: 'Who is rated']
  order_id bigint [unique, note: 'One review per delivered order']
  rating int [note: '1 to 5 stars']
  review text
  created_at datetime
}

// --------------------------- Groups by service ---------------------------

TableGroup user_service [color: #6c8ebf] {
  users
}

TableGroup restaurant_service [color: #82b366] {
  restaurants
  categories
  dishes
  inventory_reservations
}

TableGroup order_service [color: #d79b00] {
  orders
  order_items
  payments
  order_status_history
}

TableGroup mongodb [color: #9673a6] {
  reviews
}
