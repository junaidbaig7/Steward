# ─────────────────────────────────────────────────────────────
# STEWARD environment configuration
# Copy to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────────────────────

# Runtime environment: development | production
# In development, OTPs are logged to the user-service console (demo only).
APP_ENV=development

# ── PostgreSQL (must be the STEWARD database) ────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=steward_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ── MongoDB (reviews, user activity) ─────────────────────────
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=steward_db

# ── Redis (OTP with TTL, light caching) ──────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_KEY_PREFIX=steward

# ── Auth ─────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRE_MINUTES=1440
OTP_TTL_SECONDS=300
# Shared secret for service-to-service calls (e.g. order → restaurant stock reservation)
INTERNAL_API_KEY=

# Google Identity Services client ID (Web application type)
GOOGLE_CLIENT_ID=

# Initial admin account (used once by scripts/create_admin.py)
ADMIN_EMAIL=admin@steward.dev
ADMIN_PASSWORD=

# ── Razorpay (TEST MODE keys only: rzp_test_...) ─────────────
# Leave blank to use the clearly-labelled development mock payment mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ── Semantic search ──────────────────────────────────────────
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384

# ── Internal service URLs (local dev; docker-compose overrides) ─
USER_SERVICE_URL=http://localhost:8001
RESTAURANT_SERVICE_URL=http://localhost:8002
ORDER_SERVICE_URL=http://localhost:8003

# Frontend origin(s) allowed by the API gateway (comma-separated)
CORS_ORIGINS=http://localhost:5173

# ── Frontend (Vite, read at build time) ──────────────────────
VITE_API_URL=http://localhost:8000/api
VITE_GOOGLE_CLIENT_ID=
